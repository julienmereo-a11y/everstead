{
  "redirects": [
    { "source": "/for-advisors", "destination": "/for-advisers", "permanent": true },
    { "source": "/advisor-dpa",  "destination": "/adviser-dpa",  "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/data/export.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/trial-reminders",    "schedule": "0 9 * * *"   },
    { "path": "/api/cron/abandoned-checkout", "schedule": "0 * * * *"   },
    { "path": "/api/cron/onboarding-sequence","schedule": "0 10 * * *"  },
    { "path": "/api/cron/reengagement",       "schedule": "0 10 * * 1"  },
    { "path": "/api/cron/annual-review",      "schedule": "0 9 1 * *"   },
    { "path": "/api/cron/birthday",            "schedule": "0 8 * * *"   },
    { "path": "/api/cron/gift-delivery",       "schedule": "0 * * * *"   },
    { "path": "/api/cron/document-expiry",    "schedule": "30 9 * * *"  }
  ]
}
