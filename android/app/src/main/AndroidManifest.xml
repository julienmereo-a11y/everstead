<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="standard"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- OAuth deep-link relay (see AuthRedirectActivity): receives
             care.everstead.app://auth-callback from the system browser and
             re-delivers it to the existing MainActivity — which must stay
             launchMode="standard" for file-chooser results, so it can't take
             VIEW intents directly without spawning a second instance. -->
        <activity
            android:name=".AuthRedirectActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="care.everstead.app" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- Holds the app at foreground priority WHILE the system photo picker
             is open, so One UI's low-memory killer can't reap the process
             mid-pick (verified: a full-system memory-pressure reap took Everstead
             down along with ~12 other cached apps). Started and stopped by
             MediaPickKeepAlivePlugin around each pick. -->
        <service
            android:name=".MediaPickService"
            android:exported="false"
            android:foregroundServiceType="shortService"
        />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-webview video messages (getUserMedia/MediaRecorder in RecorderSheet).
         Recording happens INSIDE the webview because launching the system camera
         gets the app process killed on One UI devices (see RecorderSheet.jsx). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The CAMERA / RECORD_AUDIO permissions above IMPLY required hardware,
         which silently dropped 427 camera-less/mic-less devices (tablets, TVs,
         Chromebooks) from the Play catalogue. Everstead is fully usable without
         either — letters, documents, and gallery uploads need no camera, and
         RecorderSheet fails soft when hardware is missing — so declare the
         features optional. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Short foreground service that keeps the app alive during a media pick
         (see the <service> above). The shortService type has NO type-specific
         permission (FOREGROUND_SERVICE_SHORT_SERVICE does not exist in the
         SDK) and is exempt from Play's typed-FGS declaration form. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
</manifest>
